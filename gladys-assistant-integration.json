      "required": false
    }
  ],
  "actions": [
    {
      "key": "run_test",
      "label": {
        "en": "Run a test now",
        "fr": "Lancer un test maintenant",
        "de": "Jetzt einen Test starten",
        "es": "Iniciar una prueba ahora"
      },
      "description": {
        "en": "15 to 40 seconds; the result is shown at the end.",
        "fr": "15 à 40 secondes ; le résultat s’affiche à la fin.",
        "de": "15 bis 40 Sekunden; das Ergebnis erscheint am Ende.",
        "es": "De 15 a 40 segundos; el resultado aparece al final."
      },
      "timeout_seconds": 120
    },
    {
      "key": "diagnostic",
      "label": {
        "en": "Diagnostic",
        "fr": "Diagnostic",
        "de": "Diagnose",
        "es": "Diagnóstico"
      },
      "description": {
        "en": "Writes the state of the integration to its logs (Settings → System), without IP address, for a bug report.",
        "fr": "Écrit l’état de l’intégration dans ses journaux (Paramètres → Système), sans adresse IP, pour un rapport de bug.",
        "de": "Schreibt den Zustand der Integration in ihre Protokolle (Einstellungen → System), ohne IP-Adresse, für einen Fehlerbericht.",
        "es": "Escribe el estado de la integración en sus registros (Ajustes → Sistema), sin dirección IP, para un informe de error."
      },
      "timeout_seconds": 10
    }
  ],
  "widgets": [
    {
      "key": "speedtest",
      "label": {
        "en": "Internet speed",
        "fr": "Débit Internet",
        "de": "Internetgeschwindigkeit",
        "es": "Velocidad de Internet"
      },
      "description": {
        "en": "Last Fast.com test, history of the speeds or of the latency, and a button to run a test.",
        "fr": "Dernier test Fast.com, historique des débits ou de la latence, et un bouton pour lancer un test.",
        "de": "Letzter Fast.com-Test, Verlauf der Geschwindigkeit oder Latenz und eine Schaltfläche für einen Test.",
        "es": "Última prueba de Fast.com, historial de velocidades o latencia y un botón para lanzar una prueba."
      },
