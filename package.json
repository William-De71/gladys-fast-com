{
  "name": "gladys-fast-com",
  "version": "0.1.1",
  "private": true,
  "description": "External Gladys Assistant integration for Fast.com, the Netflix speed test: download, upload, latency and jitter on a schedule, a dashboard widget, scene triggers and actions.",
  "homepage": "https://github.com/William-De71/gladys-fast-com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-fast-com.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "measure": "node scripts/measure.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0",
  "keywords": [
    "gladys-assistant",
    "gladys-assistant-integration",
    "fast-com",
    "speedtest",
    "internet-speed",
    "netflix",
    "home-automation"
  ]
}
